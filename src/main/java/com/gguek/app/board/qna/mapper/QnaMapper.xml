<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="com.gguek.app.board.qna.mapper.QnaMapper">
  
  <select id="list" resultType="QnaDTO">
  	select * from "TB_QNA"
  </select>
  
  
  <insert id="create" parameterType="QnaDTO">
  	insert into "TB_QNA" (
  			"BOARD_NUM"
			"BOARD_TITLE",
			"BOARD_WRITER",
			"BOARD_CONTENTS",
			"BOARD_DATE",
			"BOARD_HIT",
			"BOARD_REF",
			"BOARD_STEP",
			"BOARD_DEPTH"
		) values (
			DEFAULT,
			#{boardTitle},
			#{boardWriter},
			#{boardContents},
			now(),
			0,
			0,
			0,
			0
		)
  </insert>
  
  
  
  
  
  
  
  
  
  
  
  </mapper>