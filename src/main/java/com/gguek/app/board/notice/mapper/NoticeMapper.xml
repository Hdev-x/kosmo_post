<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.gguek.app.board.notice.mapper.NoticeMapper">

	<sql id="search_sql">
		where
		<choose>
			<when test="kind == 'v2'">"BOARD_CONTENTS"</when>
			<when test="kind == 'v3'">"BOARD_WRITER"</when>
			<otherwise>"BOARD_TITLE"</otherwise>
		</choose>
		like concat('%',#{search},'%')
	</sql>

<select id="getCount" resultType="Long" parameterType="Pager">
	select count("BOARD_NUM") from "TB_NOTICE"
	<include refid="search_sql"></include>
</select>

	<select id="list" resultType="NoticeDTO" parameterType="Pager">
		select *
		from
			"TB_NOTICE"
		<include refid="search_sql"></include>
		order by
			"BOARD_NUM" desc
		limit
			#{perPage}
		offset
			#{startNum}
	</select>

	<insert id="create" parameterType="NoticeDTO" useGeneratedKeys="true" keyProperty="boardNum">
		INSERT INTO
		"TB_NOTICE" (
			"BOARD_NUM",
			"BOARD_TITLE",
			"BOARD_WRITER",
			"BOARD_CONTENTS",
			"BOARD_DATE",
			"BOARD_HIT"
		) VALUES (
			DEFAULT,
			#{boardTitle},
			#{boardWriter},
			#{boardContents},
			now(),
			0
		)
	</insert>


<insert id="createFile" parameterType="NoticeFileDTO">
	insert into
		"TB_NOTICE_FILE"
	values(
		DEFAULT,
		#{fileName},
		#{originName},
		#{boardNum}
	)	
</insert>











</mapper>